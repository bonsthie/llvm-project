


---
name:            test_zext_v16s8_to_v16s16
legalized:       true
regBankSelected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: vecr, preferred-register: '', flags: [  ] }
  - { id: 1, class: vecr, preferred-register: '', flags: [  ] }
body: |
  bb.0:
    liveins: $xmm0

    %1:vecr(<16 x s8>) = COPY $xmm0
    %2:vecr(<16 x s16>) = G_ZEXT %1
    RET 0, implicit %2
...


